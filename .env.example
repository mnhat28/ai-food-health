# ==========================================
# DATABASE
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=yourpassword
POSTGRES_DB=ai_food_health
DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@db:5432/ai_food_health

# ==========================================
# REDIS
# ==========================================
REDIS_URL=redis://redis:6379

# ==========================================
# JWT AUTH
# ==========================================
SECRET_KEY=your-super-secret-key-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==========================================
# CLAUDE API
# ==========================================
ANTHROPIC_API_KEY=sk-ant-...

# ==========================================
# SENDGRID EMAIL
# ==========================================
SENDGRID_API_KEY=SG....
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=AI Food Health

# ==========================================
# CLOUDINARY (lưu ảnh món ăn)
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==========================================
# USDA FOOD API
# ==========================================
USDA_API_KEY=your_usda_api_key

# ==========================================
# ML SERVICE
# ==========================================
ML_SERVICE_URL=http://ml:8001
ML_MODEL_PATH=./models/food_classifier.onnx

# ==========================================
# FRONTEND
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=AI Food Health

# ==========================================
# ENVIRONMENT
# ==========================================
ENVIRONMENT=development
DEBUG=true